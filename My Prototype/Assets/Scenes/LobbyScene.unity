PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1921422860}
    m_Modifications:
    - target: {fileID: 4052637959285967561, guid: 14032c72f92091147b4f2ea100359b22, type: 3}
      propertyPath: weaponTrees.Array.data[0].nodes.Array.data[0].weaponDescription
      value: "\uC870\uC900\uC2DC \uCD1D\uC5F4\uC774 \uD68C\uC804\uD558\uC5EC \uBE60\uB974\uAC8C
        \uD0C4\uC744 \uBC1C\uC0AC\uD55C\uB2E4\uB124.\n\uCD5C\uB300\uB85C \uBE60\uB974\uAC8C
        \uBC1C\uC0AC\uD558\uAE30\uB97C \uC6D0\uD55C\uB2E4\uBA74 \uCD1D\uC5F4\uC774
        \uBE60\uB974\uAC8C \uD68C\uC804\uD560\uB584\uAE4C\uC9C0 \uAE30\uB2E4\uB824\uC57C
        \uD55C\uB2E4\uB124."
      objectReference: {fileID: 0}
    - target: {fileID: 4052637959285967561, guid: 14032c72f92091147b4f2ea100359b22, type: 3}
      propertyPath: weaponTrees.Array.data[0].nodes.Array.data[1].weaponDescription
      value: "\uD0C4\uCC29 \uC9C0\uC810\uC5D0 \uC791\uC740 \uD3ED\uBC1C\uC774 \uC77C\uC5B4\uB098
        \uBC94\uC704 \uACF5\uACA9\uC744 \uC8FC\uB294 \uD3ED\uBC1C\uD0C4\uC744 \uB0B4\uC7A5\uD55C\uB2E4\uB124. "
      objectReference: {fileID: 0}
    - target: {fileID: 4052637959285967561, guid: 14032c72f92091147b4f2ea100359b22, type: 3}
      propertyPath: weaponTrees.Array.data[1].nodes.Array.data[0].weaponDescription
      value: "\uD070 \uBC94\uC704\uB97C \uACF5\uACA9\uD558\uB294 \uB85C\uCF13 \uB7F0\uCC98\uB77C\uB124."
      objectReference: {fileID: 0}
    - target: {fileID: 4052637959285967561, guid: 14032c72f92091147b4f2ea100359b22, type: 3}
      propertyPath: weaponTrees.Array.data[1].nodes.Array.data[1].weaponDescription
      value: "\uD3ED\uBC1C\uC2DC \uC791\uC778 \uD3ED\uD0C4 \uC5EC\uB7EC\uAC1C\uAC00
        \uC3DF\uC544\uC9C0\uB294 \uD074\uB7EC\uC2A4\uD130 \uD3ED\uD0C4 \uB85C\uCF13\uC744
        \uB0B4\uC7A5\uD55C \uB7F0\uCC98\uB85C \uC5C5\uADF8\uB798\uC774\uB4DC \uD55C\uB2E4\uB124."
      objectReference: {fileID: 0}
    - target: {fileID: 4052637959285967561, guid: 14032c72f92091147b4f2ea100359b22, type: 3}
      propertyPath: weaponTrees.Array.data[1].nodes.Array.data[2].weaponDescription
      value: "\uD55C \uBC29\uC758 \uD654\uB825\uC774 \uC57D\uD574\uC9C0\uB294 \uB300\uC2E0
        \uC5EC\uB7EC\uBC1C\uC758 \uC791\uACE0 \uBE60\uB978 \uB85C\uCF13\uC744 \uC5F0\uC18D\uC73C\uB85C
        \uBC1C\uC0AC\uD558\uB294 \uB7F0\uCC98\uB85C \uAC1C\uC870\uD55C\uB2E4\uB124.."
      objectReference: {fileID: 0}
    - target: {fileID: 4052637959285967561, guid: 14032c72f92091147b4f2ea100359b22, type: 3}
      propertyPath: weaponTrees.Array.data[2].nodes.Array.data[0].weaponDescription
      value: "\uC0B0\uD0C4\uC744 \uB113\uC740 \uBC94\uC704\uB85C \uBC1C\uC0AC\uD558\uB294
        \uBB34\uAE30\uB77C\uB124.\n\uBC1C\uC0AC\uD558\uC9C0 \uC54A\uACE0 \uC624\uB798
        \uC870\uC900 \uD558\uBA74 \uD0C4\uD37C\uC9D0\uC774 \uC904\uC5B4\uB4E4\uACE0
        \uBC1C\uC0AC\uC2DC \uCD08\uAE30\uD654 \uB418\uB294 \uCD08\uD0B9 \uAE30\uB2A5\uC774
        \uAE30\uBCF8 \uB0B4\uC7A5\uB418\uC5B4 \uC788\uC9C0."
      objectReference: {fileID: 0}
    - target: {fileID: 4052637959285967561, guid: 14032c72f92091147b4f2ea100359b22, type: 3}
      propertyPath: weaponTrees.Array.data[2].nodes.Array.data[1].weaponDescription
      value: "\uCD08\uD0B9 \uAE30\uB2A5\uC774 \uC5C6\uB294 \uB300\uC2E0 \uAE30\uBCF8
