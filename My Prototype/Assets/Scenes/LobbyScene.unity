      propertyPath: weaponTrees.Array.data[0].nodes.Array.data[0].weaponDescription
      value: "\uC870\uC900\uC2DC \uCD1D\uC5F4\uC774 \uD68C\uC804\uD558\uC5EC \uBE60\uB974\uAC8C
        \uD0C4\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
