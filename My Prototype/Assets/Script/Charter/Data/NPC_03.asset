  npcName: "\uD544\uB85C\uC18C\uD504"
  npcPortrait: {fileID: 0}
  stats:
  - statName: Health
    value: 1000
  firstDialogue:
  - "\uBC8C\uB808\uB294 \uC695\uB9DD\uC744 \uC5B5\uB204\uB97C \uC218 \uC5C6\uB2E4."
  - "\uBC30\uAC00 \uACE0\uD504\uB2E4 \uD558\uBA74 \uB3D9\uC871\uC744 \uBA39\uACE0,
    \uD654\uAC00 \uB098\uBA74 \uADF8\uACF3\uC774 \uBD88\uAE38 \uC18D\uC774\uB77C\uB3C4
    \uB2EC\uB824\uB4E0\uB2E4."
  - "\uC778\uAC04\uC758 \uC2DD\uC0AC\uC640 \uB2EC\uB9AC \uBC8C\uB808\uB294 \uC12D\uCDE8\uD55C\uB2E4.
    \uC695\uB9DD\uC744 \uC5B5\uB204\uB974\uC9C0 \uBABB\uD558\uC5EC \uB5A8\uC5B4\uC9C4\uAC78
    \uAC09\uC544 \uBA39\uB294 \uAC83... \uADF8\uAC83\uC774 \uBC8C\uB808\uC758 \uBCF8\uC131\uC774\uB2E4.
    \uC778\uB0B4\uB97C \uD558\uB294 \uAC83\uC774 \uC544\uB2C8\uB77C!"
  - "\uADF8 \uBCF8\uC9C8\uC801 \uCC28\uC774\uB85C \uBC8C\uB808\uB294 \uC778\uAC04\uACFC\uC758
    \uC2F8\uC6C0\uC5D0\uC11C \uC2B9\uB9AC\uD55C\uC801 \uC5C6\uB2E4."
  - "\uC790\uB124\uB294 \uB2E4\uB978\uAC00?"
  repeatDialogue:
  - "\uC778\uAC04\uC758 \uC548\uBC30... \uBB50 \uADF8\uB7F0 \uAC83\uC774\uACA0\uC9C0. "
